# Backend environment template for Mico Industrial Press.
# Copy this file to .env during local setup and fill real values outside version control.

NODE_ENV=development
PORT=3001

# Comma-separated frontend origins allowed to call this API.
# Production should use the exact deployed frontend domain. Do not use * in production.
# Examples:
# FRONTEND_ORIGIN=http://localhost:3000,https://micoindustrialpress.com
FRONTEND_ORIGIN=http://localhost:3000

# Business details used in emails and health metadata.
BUSINESS_NAME=Mico Industrial Press
BUSINESS_EMAIL=micoindustrial@yahoo.com
BUSINESS_PHONE=08037400918
BUSINESS_ADDRESS=No 24 Zik Avenue Amawbia, Awka-South L.G.A, Anambra State

# Email provider settings. Do not commit real credentials.
#
# Required for email sending:
# - SMTP_HOST: SMTP server hostname.
# - SMTP_PORT: usually 587 for STARTTLS, or 465 for SSL.
# - SMTP_SECURE: false for port 587, true for port 465.
# - SMTP_USER: SMTP account username, usually the full email address.
# - SMTP_PASS: SMTP password or provider app password.
# - SMTP_FROM: sender name and email shown to customers.
#
# Gmail local testing example:
# 1. Turn on 2-Step Verification on the Google account.
# 2. Create a Google App Password for this site/API.
# 3. Use the 16-character app password as SMTP_PASS, not the normal Gmail password.
# 4. Use these settings:
#    SMTP_HOST=smtp.gmail.com
#    SMTP_PORT=587
#    SMTP_SECURE=false
#    SMTP_USER=your-gmail-address@gmail.com
#    SMTP_PASS=your-16-character-app-password-without-spaces
#    SMTP_FROM="Mico Industrial Press <your-gmail-address@gmail.com>"
#
# Alternative SMTP providers:
# - Brevo/Sendinblue, Mailgun, SendGrid SMTP, Postmark SMTP, Amazon SES SMTP,
#   Zoho Mail SMTP, or a domain email provider.
# - Prefer a provider that supports authenticated SMTP, SPF/DKIM setup, and
#   reliable transactional email delivery.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Optional quote artwork upload behavior.
UPLOADS_ENABLED=false
MAX_UPLOAD_SIZE=5242880
# Maximum size for each normal multipart form field when uploads are enabled.
MAX_UPLOAD_FIELD_SIZE=102400

# Request protection.
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=30
HONEYPOT_FIELD=website
JSON_BODY_LIMIT=100kb
